@model IEnumerable<dynamic>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Audit Logs";
}

<div class="page-header">
    <div class="breadcrumb-biz"><i class="fa-solid fa-house"></i><span class="sep">/</span><span>System Access</span></div>
    <div class="d-flex align-center justify-between">
        <div>
            <h1><span>System</span> Audit Logs</h1>
            <p>Trace all critical events and database modifications.</p>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div class="panel-title"><i class="fa-solid fa-clock-rotate-left panel-icon"></i> Recent Activity</div>
    </div>
    
    <div style="overflow-x:auto;">
        <table class="table-biz">
            <thead>
                <tr>
                    <th>Log ID</th>
                    <th>Date & Time</th>
                    <th>Module</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td style="font-family:monospace; color:var(--text-muted);">#@log.LogId</td>
                        <td>@log.ActionDate</td>
                        <td><span class="badge-biz info">@log.TableName</span></td>
                        <td>
                            @{
                                string actionCls = "info";
                                string type = log.ActionType.ToString().ToUpper();
                                if (type.Contains("UPDATE")) actionCls = "warning";
                                else if (type.Contains("INSERT") || type.Contains("CREATE")) actionCls = "success";
                                else if (type.Contains("DELETE") || type.Contains("DROP")) actionCls = "danger";
                            }
                            <span class="badge-biz @actionCls">@log.ActionType</span>
                        </td>
                        <td style="font-size:13px; max-width:400px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="@log.Details">
                            @log.Details
                        </td>
                        <td style="font-family:monospace; font-size:12px;">@log.IPAddress</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:30px; color:var(--text-muted);">
                            <i class="fa-solid fa-ghost" style="font-size:32px; opacity:0.2; margin-bottom:15px; display:block;"></i>
                            No audit activity found for this company yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
