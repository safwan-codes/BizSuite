@model IEnumerable<BizSuite.Models.Customer>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <div class="breadcrumb-biz">
        <i class="fa-solid fa-house"></i><span class="sep">/</span>
        <span>Customers</span>
    </div>
    <div class="d-flex align-center justify-between">
        <div>
            <h1><span>Customer</span> Management</h1>
            <p>View and manage all your CRM contacts in one place</p>
        </div>
        <a href="/Admin/CreateCustomer" class="quick-action-btn">
            <i class="fa-solid fa-user-plus"></i> Add Customer
        </a>
    </div>
</div>

<div class="filter-bar mb-24">
    <div class="filter-search">
        <i class="fa-solid fa-magnifying-glass filter-search-icon"></i>
        <input type="text" class="table-search-input" data-target=".table-biz" placeholder="Search customers..." />
    </div>
    <select class="filter-select filter-select" data-col="6" data-target=".table-biz">
        <option value="">All Customers</option>
        <option value="false">Active</option>
        <option value="true">Inactive</option>
    </select>
    <a href="/Admin/ExportCustomers" class="btn-biz-outline" style="text-decoration:none;">
        <i class="fa-solid fa-arrow-down-to-bracket"></i> Export CSV
    </a>
</div>

<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:24px;">
    <div class="stat-mini">
        <div class="stat-mini-value text-lime">@Model.Count()</div>
        <div class="stat-mini-label">Total Customers</div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-value" style="color:var(--success);">@Model.Count(c => !c.IsDeleted)</div>
        <div class="stat-mini-label">Active</div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-value" style="color:var(--danger);">@Model.Count(c => c.IsDeleted)</div>
        <div class="stat-mini-label">Inactive</div>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div class="panel-title">
            <i class="fa-solid fa-users panel-icon"></i> All Customers
        </div>
        <span style="font-size:12px; color:var(--text-muted);">@Model.Count() records</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="table-biz">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>Orders</th>
                    <th>Total Spend</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    bool deleted = c.IsDeleted;
                    <tr style="@(deleted ? "opacity:0.55;" : "")">
                        <td>
                            <div class="d-flex align-center gap-12">
                                @if (c.ImageData != null && c.ImageData.Length > 0)
                                {
                                    <div style="width:36px; height:36px; border-radius:50%; overflow:hidden; flex-shrink:0;">
                                        <img src="/Admin/GetCustomerImage/@c.CustomerId" alt="@c.CustomerName" style="width:100%; height:100%; object-fit:cover;" />
                                    </div>
                                }
                                else
                                {
                                    <div style="width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,var(--accent-lime),var(--accent-mint)); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; color:var(--text-dark); flex-shrink:0;">
                                        @(!string.IsNullOrEmpty(c.CustomerName) ? c.CustomerName[0].ToString() : "?")
                                    </div>
                                }
                                <div>
                                    <div style="font-weight:600; color:var(--text-primary); font-size:13px;">@c.CustomerName</div>
                                    <div style="font-size:11px; color:var(--text-muted);">ID #@c.CustomerId</div>
                                </div>
                            </div>
                        </td>
                        <td>@c.Email</td>
                        <td>@c.Phone</td>
                        <td>@c.Address</td>
                        <td><span style="font-weight:600; color:var(--accent-lime);">@c.Orders</span></td>
                        <td><strong style="color:var(--text-primary);">₹@c.Spend.ToString("N0")</strong></td>
                        <td>
                            @if (deleted)
                            {
                                <span class="badge-biz danger"><span class="badge-dot"></span>Inactive</span>
                            }
                            else
                            {
                                <span class="badge-biz success"><span class="badge-dot"></span>Active</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-8">
                                <a href="/Admin/EditCustomer/@c.CustomerId" class="btn-action" data-tooltip="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                @if (!deleted)
                                {
                                    <form asp-action="DeleteCustomer" method="post" style="display:inline;" onsubmit="return confirm('Hold up! Are you sure you want to delete this customer?');">
                                        <input type="hidden" name="customerId" value="@c.CustomerId" />
                                        <button type="submit" class="btn-action" style="background:rgba(239,68,68,0.1);color:var(--danger);border-color:rgba(239,68,68,0.2);" data-tooltip="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>