@model BizSuite.Models.CustomerViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Edit Customer";
}

<div class="page-header">
    <div class="breadcrumb-biz">
        <i class="fa-solid fa-house"></i>
        <span class="sep">/</span><a href="/Admin/Customers">Customers</a>
        <span class="sep">/</span><span>Edit Customer</span>
    </div>
    <h1><span>Edit</span> Customer</h1>
    <p>Update CRM contact profile #@Model.CustomerId.</p>
</div>

<div class="panel" style="max-width:800px;">
    <div class="panel-header">
        <div class="panel-title">
            <i class="fa-solid fa-pen-to-square panel-icon"></i> Update Customer Profile
        </div>
    </div>
    <div class="panel-body">
        <form asp-action="EditCustomer" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="CustomerId" />
            <div asp-validation-summary="ModelOnly" class="validation-err mb-16"></div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                <div style="grid-column:1/-1;">
                    <label class="form-label-biz" asp-for="CustomerName">Full Name / Company Name *</label>
                    <input asp-for="CustomerName" class="form-input-biz" />
                    <span asp-validation-for="CustomerName"></span>
                </div>
                <div>
                    <label class="form-label-biz" asp-for="Email">Email Address *</label>
                    <input asp-for="Email" class="form-input-biz" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div>
                    <label class="form-label-biz" asp-for="Phone">Phone Number *</label>
                    <input asp-for="Phone" class="form-input-biz" />
                    <span asp-validation-for="Phone"></span>
                </div>
                <div style="grid-column:1/-1;">
                    <label class="form-label-biz" asp-for="Address">Address / Location</label>
                    <textarea asp-for="Address" class="form-input-biz" style="min-height:80px;"></textarea>
                    <span asp-validation-for="Address"></span>
                </div>
                <div style="grid-column:1/-1;">
                    <label class="form-label-biz">Customer Logo / Picture (Optional)</label>
                    <div class="d-flex align-center gap-16">
                        <img src="/Admin/GetCustomerImage/@Model.CustomerId" onerror="this.src='/assets/images/default-avatar.png'" style="width:50px; height:50px; border-radius:50%; object-fit:cover; border:2px solid var(--accent-lime);" />
                        <input type="file" name="ImageFile" accept="image/*" class="form-input-biz" style="flex:1;" />
                    </div>
                </div>
                <div style="grid-column:1/-1;">
                    <label class="d-flex align-center gap-8" style="font-size:14px; color:var(--text-primary); cursor:pointer;">
                        <input asp-for="IsDeleted" type="checkbox" style="width:18px; height:18px; accent-color:var(--danger);" />
                        Mark as Inactive / Deleted
                    </label>
                </div>
            </div>

            <div class="d-flex gap-16" style="margin-top:32px; padding-top:24px; border-top:1px solid rgba(255,255,255,0.05);">
                <button type="submit" class="quick-action-btn">
                    <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
                <a href="/Admin/Customers" class="btn-biz-outline" style="padding:10px 20px;">Cancel</a>
            </div>
        </form>
    </div>
</div>
