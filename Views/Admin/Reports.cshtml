@model BizSuite.Models.Dashboard.AdminDashboardViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <div class="breadcrumb-biz"><i class="fa-solid fa-house"></i><span class="sep">/</span><span>Reports</span></div>
    <div class="d-flex align-center justify-between">
        <div>
            <h1><span>Analytics</span> & Reports</h1>
            <p>Deep insights into your business performance</p>
        </div>
        <button class="quick-action-btn secondary" onclick="window.open('/Admin/DownloadReport', '_blank');">
            <i class="fa-solid fa-file-pdf"></i> Export PDF
        </button>
    </div>
</div>

<div class="kpi-grid" style="grid-template-columns:repeat(4,1fr);">
    <div class="kpi-card lime">
        <div class="kpi-card-header"><span class="kpi-card-label">FY Revenue</span><div class="kpi-icon lime"><i class="fa-solid fa-sack-dollar"></i></div></div>
        <div class="kpi-value">₹@Model.TotalSales.ToString("N0")</div>
        <div class="kpi-change @(Model.TotalSales > 0 ? "up" : "")"><i class="fa-solid fa-arrow-trend-up"></i> +0.0% <span>YoY</span></div>
    </div>
    <div class="kpi-card mint">
        <div class="kpi-card-header"><span class="kpi-card-label">Avg Order Value</span><div class="kpi-icon mint"><i class="fa-solid fa-chart-line"></i></div></div>
        <div class="kpi-value">₹@(Model.TotalOrders > 0 ? (Model.TotalSales / Model.TotalOrders).ToString("N0") : "0")</div>
        <div class="kpi-change @(Model.TotalOrders > 0 ? "up" : "")"><i class="fa-solid fa-arrow-trend-up"></i> +0.0% <span>vs Q3</span></div>
    </div>
    <div class="kpi-card info">
        <div class="kpi-card-header"><span class="kpi-card-label">Orders Fulfilled</span><div class="kpi-icon info"><i class="fa-solid fa-boxes-stacked"></i></div></div>
        <div class="kpi-value">@Model.TotalOrders</div>
        <div class="kpi-change @(Model.TotalOrders > 0 ? "up" : "")"><i class="fa-solid fa-arrow-trend-up"></i> +0 <span>this month</span></div>
    </div>
    <div class="kpi-card danger">
        <div class="kpi-card-header"><span class="kpi-card-label">Pending Revenue</span><div class="kpi-icon danger"><i class="fa-solid fa-clock-rotate-left"></i></div></div>
        <div class="kpi-value">₹@Model.PendingPayments.ToString("N0")</div>
        <div class="kpi-change @(Model.PendingPayments > 0 ? "warn" : "")"><i class="fa-solid fa-circle-exclamation"></i> <span>0 invoices</span></div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1.4fr 1fr; gap:20px; margin-bottom:24px;">
    
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title"><i class="fa-solid fa-chart-line panel-icon"></i> Sales Trend (12 Months)</div>
            <select class="filter-select" style="font-size:12px; padding:6px 10px; border-radius:8px;">
                <option>FY 2025–26</option>
                <option>FY 2024–25</option>
            </select>
        </div>
        <div class="panel-body">
            <div class="chart-container" style="height:260px;">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <div class="panel-title"><i class="fa-solid fa-ranking-star panel-icon"></i> Top Products</div>
        </div>
        <div class="panel-body">
            <div class="chart-container" style="height:260px;">
                <canvas id="topProdChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
    
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title"><i class="fa-solid fa-crown panel-icon"></i> High-Value Customers</div>
        </div>
        <table class="table-biz">
            <thead>
                <tr><th>Customer</th><th>Orders</th><th>Spend</th><th>Score</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model.TopCustomers)
                {
                    var score = c.TotalSpend > 100000 ? 95 : (c.TotalSpend > 50000 ? 85 : 70);
                    <tr>
                        <td>
                            <div class="d-flex align-center gap-10">
                                <div style="width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,var(--accent-lime),var(--accent-mint)); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:var(--text-dark);">@c.CustomerName[0]</div>
                                @c.CustomerName
                            </div>
                        </td>
                        <td><span class="badge-biz info">@c.Orders</span></td>
                        <td><strong style="color:var(--accent-lime);">₹@(c.TotalSpend.ToString("N0"))</strong></td>
                        <td>
                            <div class="d-flex align-center gap-8">
                                <div style="flex:1; height:5px; background:rgba(255,255,255,0.08); border-radius:10px; overflow:hidden;">
                                    <div style="width:@score%; height:100%; background:@(score>=90?"var(--accent-lime)":score>=70?"var(--accent-mint)":"var(--warning)"); border-radius:10px;"></div>
                                </div>
                                <span style="font-size:12px; font-weight:700; color:var(--text-secondary); width:28px; text-align:right;">@score</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="panel">
        <div class="panel-header">
            <div class="panel-title"><i class="fa-solid fa-tags panel-icon"></i> Sales by Category</div>
        </div>
        <div class="panel-body">
            @{
                var totalRev = Model.CategorySales.Sum(s => s.Revenue);
                var colors = new[] { "var(--accent-lime)", "var(--accent-mint)", "var(--info)", "var(--warning)", "var(--danger)" };
                int idx = 0;
            }
            @if (!Model.CategorySales.Any())
            {
                <div style="text-align:center; color:var(--text-muted); padding:40px 0;">No category data yet.</div>
            }
            @foreach (var cat in Model.CategorySales)
            {
                var pct = totalRev > 0 ? (int)Math.Round((cat.Revenue / totalRev) * 100) : 0;
                var color = colors[idx % colors.Length];
                idx++;
                <div style="margin-bottom:20px;">
                    <div class="d-flex align-center justify-between mb-8">
                        <span style="font-size:13px; font-weight:600; color:var(--text-secondary);">@cat.CategoryName</span>
                        <div class="d-flex align-center gap-12">
                            <span style="font-size:13px; font-weight:700; color:var(--text-primary);">₹@cat.Revenue.ToString("N0")</span>
                            <span style="font-size:12px; font-weight:700; color:@color;">@pct%</span>
                        </div>
                    </div>
                    <div style="height:7px; background:rgba(255,255,255,0.06); border-radius:10px; overflow:hidden;">
                        <div style="width:@pct%; height:100%; background:@color; border-radius:10px; transition:width 0.8s ease;"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
$(function () {
    var months = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthLabels));
    var sales  = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyRevenue));
    BizSuite.initTrendChart('trendChart', months, sales);

    var products = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TopProducts.Select(p => p.ProductName)));
    var units    = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TopProducts.Select(p => p.UnitsSold))); 
    BizSuite.initTopProductsChart('topProdChart', products, units);
});
</script>

<style>
    @@media print {
        .sidebar-biz, .topbar-biz, .page-header .quick-action-btn, .breadcrumb-biz { display: none !important; }
        .main-content { margin-left: 0 !important; padding: 0 !important; width: 100% !important; }
        .kpi-grid { display: flex !important; flex-wrap: wrap !important; }
        .kpi-card { width: 23% !important; margin: 1% !important; border: 1px solid #ddd !important; -webkit-print-color-adjust: exact; }
        .panel { break-inside: avoid !important; border: 1px solid #eee !important; }
        canvas { max-width: 100% !important; height: auto !important; }
    }
</style>
}
