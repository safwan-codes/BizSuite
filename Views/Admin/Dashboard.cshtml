@model BizSuite.Models.Dashboard.AdminDashboardViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div class="d-flex align-center justify-between">
        <div>
            <div class="breadcrumb-biz">
                <i class="fa-solid fa-gauge"></i>
                <span class="sep">/</span>
                <span>Dashboard</span>
            </div>
            <h1>Welcome back, <span>@Model.UserFullName.Split(' ')[0]</span> </h1>
            <p>Here's what's happening in your business today — @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
        </div>
        <div class="d-flex gap-12 d-none d-md-flex">
          @*   <a href="/Staff/StaffList" class="btn-biz-outline" style="border-radius:12px; padding:8px 16px;">
                <i class="fa-solid fa-users-gear"></i> Manage Team
            </a> *@
            <a href="/Staff/OrderEntry" class="quick-action-btn">
                <i class="fa-solid fa-circle-plus"></i> New Order
            </a>
        </div>
    </div>
</div>

@if (TempData["Welcome"] != null)
{
    <div style="background:rgba(201,247,111,0.1); border:1px solid rgba(201,247,111,0.3); border-radius:var(--radius-md); padding:14px 20px; margin-bottom:24px; display:flex; align-items:center; gap:12px; font-size:14px; color:var(--accent-lime);">
        <i class="fa-solid fa-party-horn"></i>
        @TempData["Welcome"]
    </div>
}

<div class="kpi-grid">
    <div class="kpi-card lime">
        <div class="kpi-card-header">
            <span class="kpi-card-label">Total Sales</span>
            <div class="kpi-icon lime"><i class="fa-solid fa-indian-rupee-sign"></i></div>
        </div>
        <div class="kpi-value" data-target="@Model.TotalSales">₹@Model.TotalSales.ToString("N0")</div>
        <div class="kpi-change @(Model.SalesGrowth >= 0 ? "up" : "down")">
            <i class="fa-solid fa-arrow-trend-@(Model.SalesGrowth >= 0 ? "up" : "down")"></i> 
            @(Model.SalesGrowth >= 0 ? "+" : "")@Model.SalesGrowth.ToString("F1")%
            <span>vs last month</span>
        </div>
    </div>

    <div class="kpi-card mint">
        <div class="kpi-card-header">
            <span class="kpi-card-label">Invoiced Amount</span>
            <div class="kpi-icon mint"><i class="fa-solid fa-file-invoice"></i></div>
        </div>
        <div class="kpi-value" data-target="@Model.InvoicedAmount">₹@Model.InvoicedAmount.ToString("N0")</div>
        <div class="kpi-change up">
            <i class="fa-solid fa-circle-check"></i> 100%
            <span>collected</span>
        </div>
    </div>

    <div class="kpi-card warn">
        <div class="kpi-card-header">
            <span class="kpi-card-label">Low Stock Alerts</span>
            <div class="kpi-icon warn"><i class="fa-solid fa-triangle-exclamation"></i></div>
        </div>
        <div class="kpi-value">@Model.LowStockCount</div>
        <div class="kpi-change @(Model.LowStockCount == 0 ? "up" : "warn")">
            <i class="fa-solid @(Model.LowStockCount == 0 ? "fa-check-circle" : "fa-arrow-trend-up")"></i> 
            @(Model.LowStockCount == 0 ? "Good" : Model.LowStockCount.ToString() + " items")
            <span>critical</span>
        </div>
    </div>

    <div class="kpi-card info">
        <div class="kpi-card-header">
            <span class="kpi-card-label">Total Customers</span>
            <div class="kpi-icon info"><i class="fa-solid fa-users"></i></div>
        </div>
        <div class="kpi-value">@Model.TotalCustomers</div>
        <div class="kpi-change up">
            <i class="fa-solid fa-user-plus"></i> Active
            <span>this month</span>
        </div>
    </div>

    <div class="kpi-card lime">
        <div class="kpi-card-header">
            <span class="kpi-card-label">Total Orders</span>
            <div class="kpi-icon lime"><i class="fa-solid fa-cart-shopping"></i></div>
        </div>
        <div class="kpi-value">@Model.TotalOrders</div>
        <div class="kpi-change up">
            <i class="fa-solid fa-bag-shopping"></i> Live
            <span>Order flow</span>
        </div>
    </div>

    <div class="kpi-card danger">
        <div class="kpi-card-header">
            <span class="kpi-card-label">Pending Payments</span>
            <div class="kpi-icon danger"><i class="fa-solid fa-clock"></i></div>
        </div>
        <div class="kpi-value" data-target="@Model.PendingPayments">₹@Model.PendingPayments.ToString("N0")</div>
        <div class="kpi-change @(Model.PendingPayments > 0 ? "down" : "up")">
            <i class="fa-solid @(Model.PendingPayments > 0 ? "fa-circle-exclamation" : "fa-check-double")"></i>
            @(Model.PendingPayments > 0 ? "Awaiting" : "Settled")
            <span>status</span>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr 340px; gap:20px; margin-bottom:24px;">

    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">
                <i class="fa-solid fa-chart-bar panel-icon"></i>
                Revenue Insights
            </div>
            <div class="panel-actions">
                <span class="badge-biz success">Trailing 12m</span>
            </div>
        </div>
        <div class="panel-body">
            <div class="chart-container" style="height:250px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">
                <i class="fa-solid fa-chart-pie panel-icon"></i>
                Sales by Category
            </div>
        </div>
        <div class="panel-body">
            <div class="chart-container" style="height:250px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">
                <i class="fa-solid fa-trophy panel-icon"></i>
                Top Customers
            </div>
            <a href="/Admin/Customers" style="font-size:12px; color:var(--accent-mint);">View all</a>
        </div>
        <div class="panel-body" style="padding:16px 24px;">
            @foreach (var (c, idx) in Model.TopCustomers.Select((x, i) => (x, i + 1)))
            {
                <div style="display:flex; align-items:center; gap:12px; padding:12px 0; @(idx < Model.TopCustomers.Count ? "border-bottom:1px solid rgba(255,255,255,0.05);" : "")">
                    <div style="width:32px; height:32px; border-radius:50%; background:@(idx==1?"var(--accent-lime)":idx==2?"var(--accent-mint)":"rgba(255,255,255,0.12)"); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; color:@(idx<=2?"var(--text-dark)":"var(--text-secondary)"); flex-shrink:0;">@idx</div>
                    <div style="flex:1; min-width:0;">
                        <div style="font-size:13px; font-weight:600; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@c.CustomerName</div>
                        <div style="font-size:11px; color:var(--text-muted);">@c.Orders orders</div>
                    </div>
                    <div style="font-size:13px; font-weight:700; color:var(--accent-lime);">₹@c.TotalSpend.ToString("N0")</div>
                </div>
            }
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <div class="panel-title">
            <i class="fa-solid fa-receipt panel-icon"></i>
            Recent Orders
        </div>
        <a href="/Admin/SalesOrders" class="btn-biz-outline">
            <i class="fa-solid fa-arrow-right"></i> View All
        </a>
    </div>
    <div style="overflow-x:auto;">
        <table class="table-biz">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.RecentOrders)
                {
                    var (badgeClass, statusDot) = o.Status switch
                    {
                        "Delivered" => ("success", ""),
                        "Confirmed" => ("lime", ""),
                        "Pending"   => ("warning", ""),
                        _           => ("info", "")
                    };
                    <tr>
                        <td><span style="font-family:monospace; font-size:13px;">#@o.OrderId</span></td>
                        <td>
                            <div class="d-flex align-center gap-8">
                                <div style="width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,var(--accent-lime),var(--accent-mint)); display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; color:var(--text-dark); flex-shrink:0;">@o.Customer[0]</div>
                                @o.Customer
                            </div>
                        </td>
                        <td>@o.Date</td>
                        <td><strong style="color:var(--accent-lime);">₹@o.Amount.ToString("N0")</strong></td>
                        <td><span class="badge-biz @badgeClass"><span class="badge-dot"></span>@o.Status</span></td>
                        <td><a href="/Admin/SalesOrders" class="btn-action" style="text-decoration:none; display:inline-block; padding:8px 12px;">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
$(function () {
    var labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthLabels));
    var data   = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyRevenue));
    BizSuite.initRevenueChart('revenueChart', labels, data);

    var catLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CategorySales.Select(x => x.CategoryName)));
    var catData   = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.CategorySales.Select(x => x.Revenue)));
    BizSuite.initCategoryChart('categoryChart', catLabels, catData);

    BizSuite.animateKPICounters();
});
</script>
}
