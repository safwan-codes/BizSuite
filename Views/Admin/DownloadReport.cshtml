@model BizSuite.Models.Dashboard.AdminDashboardViewModel
@{
    Layout = null; 
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.ReportType - @Model.CompanyName</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
        
        body {
            font-family: 'Inter', -apple-system, sans-serif;
            color: #111827;
            background: #fff;
            margin: 0;
            padding: 40px;
            line-height: 1.5;
        }

        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #f3f4f6;
            padding-bottom: 30px;
            margin-bottom: 40px;
        }

        .company-info h1 {
            font-size: 24px;
            font-weight: 800;
            color: #111827;
            margin: 0 0 4px 0;
            letter-spacing: -0.5px;
        }

        .company-info p {
            font-size: 14px;
            color: #6b7280;
            margin: 0;
        }

        .report-meta {
            text-align: right;
        }

        .report-type {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #059669;
            margin-bottom: 4px;
        }

        .report-date {
            font-size: 16px;
            font-weight: 700;
            color: #111827;
        }

        .section-title {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin: 0 0 20px 0;
            border-bottom: 1px solid #f3f4f6;
            padding-bottom: 8px;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .kpi-card {
            padding: 16px;
            background: #f9fafb;
            border-radius: 8px;
            border: 1px solid #f3f4f6;
        }

        .kpi-label {
            font-size: 11px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .kpi-value {
            font-size: 20px;
            font-weight: 800;
            color: #111827;
        }
        
        .kpi-sub {
            font-size: 12px;
            color: #059669;
            margin-top: 4px;
            font-weight: 600;
        }

        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th {
            text-align: left;
            padding: 10px;
            border-bottom: 2px solid #f3f4f6;
            color: #374151;
            font-weight: 700;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #f3f4f6;
            color: #4b5563;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .footer {
            margin-top: 60px;
            padding-top: 20px;
            border-top: 1px solid #f3f4f6;
            text-align: center;
            font-size: 12px;
            color: #9ca3af;
        }

        @@media print {
            body { padding: 0; }
            .no-print { display: none; }
            button { display: none; }
        }
        
        .no-print-zone {
            background: #f3f4f6;
            padding: 12px 20px;
            margin: -40px -40px 40px -40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        button.print-btn {
            background: #111827;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="no-print-zone no-print">
        <span style="font-size: 13px; color: #4b5563;">This is a print-optimized professional report. Use the button to save as PDF.</span>
        <button class="print-btn" onclick="window.print()">Print / Save as PDF</button>
    </div>

    <div class="report-header">
        <div class="company-info">
            <h1>@Model.CompanyName</h1>
            <p>Generated by @Model.UserFullName • @DateTime.Now.ToString("dd MMM yyyy HH:mm")</p>
        </div>
        <div class="report-meta">
            <div class="report-type">@Model.ReportType</div>
            <div class="report-date">@Model.ReportPeriod</div>
        </div>
    </div>

    <h2 class="section-title">Key Performance Indicators</h2>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Selected Period Revenue</div>
            <div class="kpi-value">₹@Model.TotalSales.ToString("N0")</div>
            <div class="kpi-sub">Actual Sales</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Average Order Value</div>
            @{
                var aov = Model.TotalOrders > 0 ? Model.TotalSales / (decimal)Model.TotalOrders : 0;
            }
            <div class="kpi-value">₹@aov.ToString("N0")</div>
            <div class="kpi-sub">Per transaction</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Orders Completed</div>
            <div class="kpi-value">@Model.TotalOrders</div>
            <div class="kpi-sub">Total Volume</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Pending Collection</div>
            <div class="kpi-value">₹@Model.PendingPayments.ToString("N0")</div>
            <div class="kpi-sub" style="color:#dc2626;">Outstanding</div>
        </div>
    </div>

    <div class="row">
        <div>
            <h2 class="section-title">Top Selling Products</h2>
            <table>
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th style="text-align:center;">Units Sold</th>
                        <th style="text-align:right;">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.TopProducts)
                    {
                        <tr>
                            <td>@p.ProductName</td>
                            <td style="text-align:center;">@p.UnitsSold</td>
                            <td style="text-align:right;">₹@p.Revenue.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div>
            <h2 class="section-title">Revenue by Category</h2>
            <table>
                <thead>
                    <tr>
                        <th>Category</th>
                        <th style="text-align:right;">Total Sales</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CategorySales)
                    {
                        <tr>
                            <td>@c.CategoryName</td>
                            <td style="text-align:right;">₹@c.Revenue.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <h2 class="section-title">High-Value Customers</h2>
    <table>
        <thead>
            <tr>
                <th>Customer Name</th>
                <th style="text-align:center;">Order Frequency</th>
                <th style="text-align:right;">Total Spend (Life)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.TopCustomers)
            {
                <tr>
                    <td>@c.CustomerName</td>
                    <td style="text-align:center;">@c.Orders</td>
                    <td style="text-align:right;">₹@c.TotalSpend.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="footer">
        Confidential Internal Document • Generated by BizSuite ERP System • Paginated automatically for archiving.
    </div>

    <script>
        window.addEventListener('load', function() {
            // setTimeout to let fonts render
            setTimeout(() => {
                // window.print(); // Optional: trigger automatically
            }, 500);
        });
    </script>
</body>
</html>