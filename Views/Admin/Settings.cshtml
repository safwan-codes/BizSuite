@model BizSuite.Models.SettingsViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Settings";
    var fullName = ViewBag.FullName as string ?? "Admin";
    var email = ViewBag.Email as string ?? "";

    var profileImage = Context.Session.GetString("ProfileImage");
    var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length > 1
        ? $"{nameParts[0][0]}{nameParts[1][0]}"
        : (nameParts.Length == 1 ? $"{nameParts[0][0]}" : "U");
    initials = initials.ToUpper();
}

<div class="page-header">
    <div class="breadcrumb-biz"><i class="fa-solid fa-house"></i><span class="sep">/</span><span>Settings</span></div>
    <h1><span>Account</span> Settings</h1>
    <p>Manage your company profile, plan, and security settings</p>
</div>

<div style="display:grid; grid-template-columns:1fr 360px; gap:24px; align-items:start;">

    <div style="display:flex; flex-direction:column; gap:20px;">

        <div class="panel">
            <div class="panel-header">
                <div class="panel-title"><i class="fa-solid fa-building panel-icon"></i> Company Profile</div>
                <button class="btn-action">Save Changes</button>
            </div>
            <div class="panel-body">
                <div class="settings-section">
                    <div class="settings-section-title">Personal Identity</div>
                    
                    <div style="display:flex; align-items:center; gap:20px; margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.05);">
                        @if (!string.IsNullOrEmpty(profileImage))
                        {
                            <img id="avatarPreview" src="@profileImage" style="width:72px; height:72px; border-radius:50%; object-fit:cover; border:2px solid var(--accent-lime);" />
                            <div id="avatarFallback" style="display:none; width:72px; height:72px; border-radius:50%; background:linear-gradient(135deg,var(--accent-lime),var(--accent-mint)); align-items:center; justify-content:center; font-size:24px; font-weight:700; color:var(--text-dark);">@initials</div>
                        }
                        else
                        {
                            <img id="avatarPreview" style="display:none; width:72px; height:72px; border-radius:50%; object-fit:cover; border:2px solid var(--accent-lime);" />
                            <div id="avatarFallback" style="width:72px; height:72px; border-radius:50%; background:linear-gradient(135deg,var(--accent-lime),var(--accent-mint)); display:flex; align-items:center; justify-content:center; font-size:24px; font-weight:700; color:var(--text-dark);">@initials</div>
                        }
                        
                        <div>
                            <div style="font-weight:600; color:white; margin-bottom:8px;">Profile Picture</div>
                            <div style="display:flex; gap:10px;">
                                <input type="file" id="profileImageInput" accept="image/png, image/jpeg, image/webp" style="display:none;" />
                                <button class="btn-biz-outline" onclick="document.getElementById('profileImageInput').click();" type="button">
                                    <i class="fa-solid fa-camera"></i> Change Picture
                                </button>
                                <button class="btn-action" id="removeAvatarBtn" style="background:rgba(248,113,113,0.1); color:#f87171;" type="button">Remove</button>
                            </div>
                            <div style="font-size:11px; color:var(--text-muted); margin-top:8px;">Recommended: Square image, Max 2MB. (PNG, JPG)</div>
                        </div>
                    </div>

                    <div class="settings-section-title">Basic Info</div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                        <div>
                            <label class="form-biz-label">Company Name</label>
                            <input class="form-biz-control" value="@Model.CompanyName" />
                        </div>
                        <div>
                            <label class="form-biz-label">Industry</label>
                            <select class="form-biz-control">
                                <option>General Business</option>
                                <option>Retail</option>
                                <option>Furniture</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-biz-label">Admin Name</label>
                            <input class="form-biz-control" value="@Model.AdminName" />
                        </div>
                        <div>
                            <label class="form-biz-label">Admin Email</label>
                            <input class="form-biz-control" type="email" value="@Model.AdminEmail" />
                        </div>
                        <div style="grid-column:span 2;">
                            <label class="form-biz-label">Business Address</label>
                            <input class="form-biz-control" placeholder="123 Business Park, Mumbai" value="@Model.BusinessAddress" />
                        </div>
                        <div>
                            <label class="form-biz-label">GST Number</label>
                            <input class="form-biz-control" placeholder="Optional" value="@Model.GstNumber" />
                        </div>
                        <div>
                            <label class="form-biz-label">Phone</label>
                            <input class="form-biz-control" placeholder="+91 98765 43210" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <div class="panel-title"><i class="fa-solid fa-shield-halved panel-icon"></i> Security</div>
            </div>
            <div class="panel-body">
                <div class="settings-section">
                    <div class="settings-section-title">Change Password</div>
                    <div style="display:flex; flex-direction:column; gap:14px; max-width:480px;">
                        <div>
                            <label class="form-biz-label">Current Password</label>
                            <input class="form-biz-control" type="password" placeholder="••••••••" />
                        </div>
                        <div>
                            <label class="form-biz-label">New Password</label>
                            <input class="form-biz-control" type="password" placeholder="Min. 6 characters" />
                        </div>
                        <div>
                            <label class="form-biz-label">Confirm New Password</label>
                            <input class="form-biz-control" type="password" placeholder="Re-enter new password" />
                        </div>
                        <button class="btn-action" style="align-self:flex-start; padding:10px 24px;">
                            Update Password
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <div class="panel-title"><i class="fa-solid fa-users-gear panel-icon"></i> Team Members</div>
                <button class="btn-action"><i class="fa-solid fa-user-plus"></i> Invite</button>
            </div>
            <table class="table-biz">
                <thead>
                    <tr><th>Member</th><th>Role</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach(var member in Model.TeamMembers)
                    {
                        var mInitials = member.FullName.Length > 0 ? member.FullName.Substring(0,1).ToUpper() : "U";
                        bool isYou = member.Email == Model.AdminEmail;
                        var roleBadgeInfo = member.Role == "Admin" ? "lime" : "mint";
                        
                    <tr>
                        <td>
                            <div class="d-flex align-center gap-10">
                                @if (isYou && !string.IsNullOrEmpty(profileImage))
                                {
                                    <img src="@profileImage" style="width:32px; height:32px; border-radius:50%; object-fit:cover;" />
                                }
                                else
                                {
                                    <div style="width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg,var(--accent-lime),var(--accent-mint)); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:var(--text-dark);">@mInitials</div>
                                }
                                <div>
                                    <div style="font-size:13px; font-weight:600; color:var(--text-primary);">@member.FullName</div>
                                    <div style="font-size:11px; color:var(--text-muted);">@member.Email</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge-biz @roleBadgeInfo">@member.Role</span></td>
                        <td><span class="badge-biz success"><span class="badge-dot"></span>@(member.IsActive ? "Active" : "Inactive")</span></td>
                        <td>
                            @if (isYou)
                            {
                                <span style="font-size:12px; color:var(--text-muted);">You</span>
                            }
                            else
                            {
                                <div class="d-flex gap-8">
                                    <button class="btn-action remove-staff-btn" data-id="@member.StaffId" style="background:rgba(248,113,113,0.2); color:var(--danger);">Remove</button>
                                </div>
                            }
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="display:flex; flex-direction:column; gap:20px;">

        <div class="panel">
            <div class="panel-header">
                <div class="panel-title"><i class="fa-solid fa-star panel-icon"></i> Current Plan</div>
            </div>
            <div class="panel-body">
                <div class="plan-card">
                    <div class="plan-info">
                        <h3 style="text-transform: capitalize;">@Model.SubscriptionPlan Plan</h3>
                        <p>Perfect for getting started</p>
                        <div class="plan-features">
                            <div class="plan-feature"><i class="fa-solid fa-circle-check"></i> 100 customers</div>
                            <div class="plan-feature"><i class="fa-solid fa-circle-check"></i> 50 products</div>
                            <div class="plan-feature"><i class="fa-solid fa-circle-check"></i> 5 users</div>
                            <div class="plan-feature" style="color:var(--text-muted);"><i class="fa-solid fa-circle-minus" style="color:var(--text-muted);"></i> Advanced analytics</div>
                            <div class="plan-feature" style="color:var(--text-muted);"><i class="fa-solid fa-circle-minus" style="color:var(--text-muted);"></i> API access</div>
                        </div>
                    </div>
                </div>
                <button class="btn-biz-primary" style="margin-top:16px;">
                    <i class="fa-solid fa-arrow-up-right-dots"></i> Upgrade to Premium
                </button>
                <div style="font-size:12px; color:var(--text-muted); text-align:center; margin-top:10px;">
                    Premium from ₹999/month · Cancel anytime
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <div class="panel-title"><i class="fa-solid fa-bell panel-icon"></i> Notifications</div>
            </div>
            <div class="panel-body" style="display:flex; flex-direction:column; gap:16px;">
                @{
                    var notifSettings = new[] {
                        new { Label="Low stock alerts",   Detail="When stock drops below threshold", On=true },
                        new { Label="New order received", Detail="Real-time order notifications",   On=true  },
                        new { Label="Payment received",   Detail="Invoice payment confirmations",   On=true  },
                        new { Label="Weekly report",       Detail="Summary email every Monday",      On=false },
                    };
                }
                @foreach (var n in notifSettings)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:16px;">
                        <div>
                            <div style="font-size:13px; font-weight:600; color:var(--text-primary);">@n.Label</div>
                            <div style="font-size:11px; color:var(--text-muted); margin-top:2px;">@n.Detail</div>
                        </div>
                        <label style="position:relative; display:inline-block; width:42px; height:22px; flex-shrink:0; cursor:pointer;">
                            <input type="checkbox" @(n.On ? "checked" : "") style="opacity:0; width:0; height:0;" />
                            <span style="position:absolute; inset:0; background:@(n.On ? "var(--accent-lime)" : "rgba(255,255,255,0.12)"); border-radius:22px; transition:var(--transition);">
                                <span style="position:absolute; width:16px; height:16px; border-radius:50%; background:white; top:3px; left:@(n.On ? "23px" : "3px"); transition:var(--transition);"></span>
                            </span>
                        </label>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div id="inviteModal" class="modal-biz" style="display:none;">
    <div class="modal-biz-content" style="max-width:480px;">
        <div class="modal-biz-header">
            <h3>Invite Team Member</h3>
            <button class="modal-close-btn" onclick="closeInviteModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form id="inviteForm">
            <div class="modal-biz-body">
                <div style="display:flex; flex-direction:column; gap:16px;">
                    <div>
                        <label class="form-biz-label">Full Name</label>
                        <input name="fullName" class="form-biz-control" placeholder="e.g. Rahul Sharma" required />
                    </div>
                    <div>
                        <label class="form-biz-label">Email Address</label>
                        <input name="email" type="email" class="form-biz-control" placeholder="rahul@example.com" required />
                    </div>
                    <div>
                        <label class="form-biz-label">Role</label>
                        <select name="role" class="form-biz-control">
                            <option value="Staff">Staff</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-biz-label">Department</label>
                        <input name="department" class="form-biz-control" placeholder="e.g. Sales, Inventory" />
                    </div>
                </div>
            </div>
            <div class="modal-biz-footer">
                <button type="button" class="btn-biz-outline" onclick="closeInviteModal()">Cancel</button>
                <button type="submit" class="btn-biz-primary" id="submitInviteBtn">Send Invitation</button>
            </div>
        </form>
    </div>
</div>

<style>

.modal-biz {
    position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center; z-index: 2000;
}
.modal-biz-content {
    background: #143d34; border: 1px solid rgba(126,227,196,0.15); border-radius: 16px;
    width: 90%; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); overflow: hidden;
}
.modal-biz-header {
    padding: 20px 24px; border-bottom: 1px solid rgba(255,255,255,0.05);
    display: flex; justify-content: space-between; align-items: center;
}
.modal-biz-header h3 { font-size: 18px; font-weight: 700; color: white; margin: 0; }
.modal-close-btn { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 20px; transition: color 0.2s; }
.modal-close-btn:hover { color: white; }
.modal-biz-body { padding: 24px; }
.modal-biz-footer { padding: 16px 24px; background: rgba(0,0,0,0.1); display: flex; justify-content: flex-end; gap: 12px; }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {

            $('#profileImageInput').on('change', function(e) {
                var file = e.target.files[0];
                if (!file) return;

                if(file.size > 2 * 1024 * 1024) {
                    BizSuite.showToast("Image must be smaller than 2MB", "warning");
                    return;
                }

                var reader = new FileReader();
                reader.onload = function(event) {
                    $('#avatarPreview').attr('src', event.target.result).show();
                    $('#avatarFallback').hide();

                    var $topbarAvatar = $('.topbar-user-avatar');
                    if ($topbarAvatar.length > 0) {
                        if($topbarAvatar.is('div')) {
                            $topbarAvatar.replaceWith('<img src="'+event.target.result+'" alt="Avatar" class="topbar-user-avatar" style="object-fit: cover; border: none; padding: 0;" />');
                        } else {
                            $topbarAvatar.attr('src', event.target.result);
                        }
                    }
                }
                reader.readAsDataURL(file);

                var formData = new FormData();
                formData.append("profileImage", file);

                $.ajax({
                    url: '/Admin/UploadProfileImage',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function(res) {
                        if(res.success) {
                            BizSuite.showToast("Profile picture updated successfully!", "success");
                        } else {
                            BizSuite.showToast(res.message || "Failed to save image.", "danger");
                        }
                    },
                    error: function() {
                        BizSuite.showToast("Server error during upload.", "danger");
                    }
                });
            });

            $('#removeAvatarBtn').on('click', function() {
                
                $('#avatarPreview').hide().attr('src', '');
                $('#avatarFallback').css('display', 'flex');

                $.post('/Admin/RemoveProfileImage', function(res) {
                    if(res.success) {
                        BizSuite.showToast("Profile picture removed.", "info");
                        
                        setTimeout(function() { window.location.reload(); }, 1000);
                    }
                });
            });

            $('.panel-header:contains("Company Profile") .btn-action').on('click', function() {
                var $btn = $(this);
                var orig = $btn.text();
                $btn.html('<i class="fa-solid fa-spinner fa-spin"></i> Saving...');
                setTimeout(function() {
                    BizSuite.showToast('Company profile updated successfully.', 'success');
                    $btn.text(orig);
                }, 600);
            });

            $('.btn-action:contains("Update Password")').on('click', function() {
                var $btn = $(this);
                var orig = $btn.text();
                $btn.html('<i class="fa-solid fa-spinner fa-spin"></i> Updating...');
                setTimeout(function() {
                    BizSuite.showToast('Security settings updated securely.', 'success');
                    $btn.text(orig);
                    $('input[type="password"]').val('');
                }, 800);
            });

            window.openInviteModal = function() {
                $('#inviteModal').fadeIn(200);
            };

            window.closeInviteModal = function() {
                $('#inviteModal').fadeOut(200);
            };

            $('#inviteForm').on('submit', function(e) {
                e.preventDefault();
                var $btn = $('#submitInviteBtn');
                var orig = $btn.text();
                $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Sending...');

                var data = {
                    FullName: $('input[name="fullName"]').val(),
                    Email: $('input[name="email"]').val(),
                    Role: $('select[name="role"]').val(),
                    Department: $('input[name="department"]').val()
                };

                $.ajax({
                    url: '/Admin/InviteStaffAjax',
                    type: 'POST',
                    data: data,
                    success: function(res) {
                        if (res.success) {
                            BizSuite.showToast(res.message, 'success');
                            closeInviteModal();
                            setTimeout(function() { window.location.reload(); }, 1500);
                        } else {
                            BizSuite.showToast(res.message, 'danger');
                            $btn.prop('disabled', false).text(orig);
                        }
                    },
                    error: function() {
                        BizSuite.showToast('Server error during invitation.', 'danger');
                        $btn.prop('disabled', false).text(orig);
                    }
                });
            });

            $('.btn-action:contains("Invite")').on('click', function() {
                openInviteModal();
            });

            $('.remove-staff-btn').on('click', function() {
                var $btn = $(this);
                var id = $btn.data('id');
                var $row = $btn.closest('tr');

                if (!confirm('Are you sure you want to remove this team member?')) return;

                $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i>');

                $.post('/Admin/DeleteStaffAjax', { staffId: id }, function(res) {
                    if (res.success) {
                        BizSuite.showToast('Team member access revoked.', 'warning');
                        $row.fadeOut(300, function() { $(this).remove(); });
                    } else {
                        BizSuite.showToast(res.message || 'Failed to remove staff.', 'danger');
                        $btn.prop('disabled', false).html('Remove');
                    }
                });
            });

            $('input[type="checkbox"]').on('change', function() {
                BizSuite.showToast('Preferences updated.', 'info');
            });

            $('.btn-biz-primary:contains("Upgrade")').on('click', function() {
                BizSuite.showToast('Redirecting to secure billing portal...', 'info');
            });
        });
    </script>
}