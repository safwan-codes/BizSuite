@model BizSuite.Models.OrderDetailViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Secure Checkout";
}

<div class="page-header">
    <div class="breadcrumb-biz">
        <i class="fa-solid fa-shield-check"></i>
        <span class="sep">/</span>
        <span>Payments</span>
    </div>
    <h1>Secure Checkout</h1>
    <p>Complete your payment for Invoice #@Model.Header.OrderId</p>
</div>

<div style="display:grid; grid-template-columns:1fr 400px; gap:30px;">
    
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">
                <i class="fa-solid fa-credit-card panel-icon"></i>
                Choose Payment Method
            </div>
        </div>
        <div class="panel-body" style="padding:30px;">
            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px;">
                <div class="payment-method-card active" data-method="Card">
                    <i class="fa-regular fa-credit-card"></i>
                    <span>Credit / Debit Card</span>
                    <div class="check"><i class="fa-solid fa-circle-check"></i></div>
                </div>
                <div class="payment-method-card" data-method="UPI">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    <span>UPI (GPay, PhonePe)</span>
                    <div class="check"><i class="fa-solid fa-circle-check"></i></div>
                </div>
                <div class="payment-method-card" data-method="Net Banking">
                    <i class="fa-solid fa-building-columns"></i>
                    <span>Net Banking</span>
                    <div class="check"><i class="fa-solid fa-circle-check"></i></div>
                </div>
            </div>

            <div id="method-details" style="margin-top:40px; padding:24px; border-radius:12px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.05);">
                
                <div id="card-tab" class="payment-tab-content">
                    <!-- Stripe Payment Element Container -->
                    <div id="stripe-payment-element" style="min-height: 200px; border-radius: 8px; padding: 10px; background: white;">
                        <span style="color:var(--text-muted); font-size:14px;"><i class="fa-solid fa-spinner fa-spin"></i> Loading secure payment gateway...</span>
                    </div>

                    <!-- Hidden old mockup fields if Stripe fails -->
                    <div id="card-mockup" style="display:none;">
                        <div class="form-biz-group" style="position:relative;">
                            <label class="form-label-biz">Card Number</label>
                            <div style="position:relative;">
                                <i class="fa-regular fa-credit-card" id="cardBrandIcon" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:18px; z-index:2;"></i>
                                <input type="text" id="cardNumberInput" class="form-input-biz" style="padding-left:40px;" placeholder="0000 0000 0000 0000" maxlength="19" />
                            </div>
                        </div>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:16px;">
                            <div class="form-biz-group">
                                <label class="form-label-biz">Expiry Date</label>
                                <input type="text" id="cardExpiryInput" class="form-input-biz" placeholder="MM/YY" maxlength="5" />
                            </div>
                            <div class="form-biz-group">
                                <label class="form-label-biz" style="display:flex; justify-content:space-between; align-items:center;">
                                    CVV Number
                                    <i class="fa-solid fa-circle-info" title="3 digits on the back of your card" style="cursor:help; color:var(--text-muted);"></i>
                                </label>
                                <input type="password" class="form-input-biz" placeholder="123" maxlength="4" />
                            </div>
                        </div>
                    </div>
                </div>

                <div id="upi-tab" class="payment-tab-content" style="display:none; text-align:center;">
                    <div class="form-biz-group" style="text-align:left; margin-bottom:24px;">
                        <label class="form-label-biz">Enter UPI ID (VPA)</label>
                        <input type="text" class="form-input-biz" placeholder="username@bank" />
                    </div>
                    <div style="position:relative; margin:20px 0;">
                        <div style="border-top:1px dashed rgba(255,255,255,0.1); width:100%;"></div>
                        <span style="position:absolute; top:-10px; left:50%; transform:translateX(-50%); background:var(--bg-card-dark); padding:0 10px; font-size:12px; color:var(--text-muted);">OR</span>
                    </div>
                    <div style="margin-bottom:20px;">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=upi://pay?pa=bizsuite@upi&pn=BizSuite%20ERP&am=@Model.Header.Total&cu=INR" 
                             alt="Payment QR" style="border:8px solid white; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,0.3);" />
                    </div>
                    <p style="color:var(--text-secondary); font-size:14px; margin-bottom:20px;">Scan this QR code with any UPI app</p>
                    <div style="display:flex; justify-content:center; gap:16px;">
                        <div class="upi-app"><img src="https://img.icons8.com/color/48/google-pay-india.png" alt="GPay" /> <span>GPay</span></div>
                        <div class="upi-app"><img src="https://img.icons8.com/color/48/phonepe.png" alt="PhonePe" /> <span>PhonePe</span></div>
                        <div class="upi-app"><img src="https://img.icons8.com/color/48/paytm.png" alt="Paytm" /> <span>Paytm</span></div>
                    </div>
                </div>

                <div id="nb-tab" class="payment-tab-content" style="display:none;">
                    <label class="form-label-biz">Select Your Bank</label>
                    <select class="form-input-biz">
                        <option value="HDFC">HDFC Bank</option>
                        <option value="ICICI">ICICI Bank</option>
                        <option value="SBI">State Bank of India</option>
                        <option value="AXIS">Axis Bank</option>
                        <option value="KOTAK">Kotak Mahindra</option>
                    </select>
                    <div style="margin-top:20px; padding:16px; border-radius:8px; background:rgba(201, 247, 111, 0.05); border:1px dashed var(--accent-lime); color:var(--text-secondary); font-size:13px;">
                        <i class="fa-solid fa-info-circle" style="color:var(--accent-lime); margin-right:8px;"></i> You will be redirected to your bank's secure login page.
                    </div>
                </div>
            </div>

            <div style="margin-top:40px; display:flex; flex-direction:column; align-items:flex-end;">
                <button class="btn-biz-pay" id="pay-btn">
                    <span class="pay-btn-content">
                        <i class="fa-solid fa-lock"></i> 
                        Pay Now (₹@Model.Header.Total.ToString("N0"))
                    </span>
                    <div class="pay-btn-glow"></div>
                </button>
                <div style="margin-top:12px; display:flex; gap:16px; color:var(--text-muted); font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">
                    <span class="d-flex align-center gap-6"><i class="fa-solid fa-shield-check"></i> 256-bit SSL Secure</span>
                    <span class="d-flex align-center gap-6"><i class="fa-brands fa-cc-stripe"></i> PCI-DSS Compliant</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Summary -->
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">Summary</div>
        </div>
        <div class="panel-body" style="padding:24px;">
            <div style="margin-bottom:24px;">
                <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px;">Invoice Number</div>
                <div style="font-size:16px; font-weight:700;"><a href="/Admin/ViewOrder/@Model.Header.OrderId" style="color:var(--accent-lime); text-decoration:none;">#@Model.Header.OrderId <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:10px; margin-left:4px;"></i></a></div>
            </div>
            <div style="margin-bottom:24px;">
                <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px;">Customer Name</div>
                <div style="font-size:16px; font-weight:600; color:var(--text-primary);">@Model.Header.Customer</div>
            </div>
            
            <div class="sidebar-divider" style="margin:20px 0;"></div>

            <div style="max-height:200px; overflow-y:auto; margin-bottom:20px;">
                @foreach (var item in Model.Items)
                {
                    <div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:14px;">
                        <div style="color:var(--text-secondary); text-transform:capitalize; display:flex; align-items:center; gap:8px;">
                            <div style="width:24px; height:24px; border-radius:6px; background:rgba(255,255,255,0.05); display:flex; align-items:center; justify-content:center;"><i class="fa-solid fa-box" style="font-size:10px; color:var(--accent-lime);"></i></div>
                            @item.ProductName.ToLower() <span style="font-size:12px; opacity:0.6;">x @item.Quantity</span>
                        </div>
                        <div style="font-weight:600; color:var(--text-primary);">₹@item.LineTotal.ToString("N0")</div>
                    </div>
                }
            </div>

            <div class="sidebar-divider" style="margin:20px 0;"></div>

            <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-size:13px; color:var(--text-muted);">
                <span>Subtotal</span>
                <span>₹@((Model.Header.Total - (Model.Header.Total * 0.18m)).ToString("N0"))</span>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:16px; font-size:13px; color:var(--text-muted);">
                <span>GST (18%)</span>
                <span>₹@((Model.Header.Total * 0.18m).ToString("N0"))</span>
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; padding-top:12px; border-top:1px dashed rgba(255,255,255,0.1);">
                <span style="font-size:16px; font-weight:700; color:var(--text-primary);">Total Payable</span>
                <span style="font-size:24px; font-weight:900; color:var(--accent-lime);">₹@Model.Header.Total.ToString("N0")</span>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-method-card {
        padding: 24px 16px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        cursor: pointer;
        position: relative;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        text-align: center;
    }
    .payment-method-card i { font-size: 26px; color: var(--text-muted); transition: color 0.25s ease; }
    .payment-method-card span { font-size: 13px; font-weight: 500; color: var(--text-muted); }
    .payment-method-card:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.1); transform: translateY(-2px); }
    .payment-method-card.active { 
        background: rgba(201, 247, 111, 0.05); 
        border: 2px solid var(--accent-lime); 
    }
    .payment-method-card.active i { color: var(--accent-lime); }
    .payment-method-card.active span { color: var(--text-primary); font-weight: 600; }
    .payment-method-card .check { position: absolute; top: 12px; right: 12px; font-size: 14px; color: var(--accent-lime); opacity: 0; transform: scale(0.5); transition: all 0.25s ease; }
    .payment-method-card.active .check { opacity: 1; transform: scale(1); }

    .upi-app { display: flex; flex-direction: column; align-items: center; gap: 8px; opacity: 0.7; transition: opacity 0.3s ease; cursor: pointer; }
    .upi-app img { width: 32px; height: 32px; filter: grayscale(20%); }
    .upi-app span { font-size: 11px; color: var(--text-muted); }
    .upi-app:hover { opacity: 1; }

    .payment-tab-content { animation: fadeIn 0.4s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    /* Premium Pay Button Styles */
    .btn-biz-pay {
        position: relative;
        padding: 16px 48px;
        font-size: 16px;
        font-weight: 700;
        color: var(--bg-dark);
        background: var(--accent-lime);
        border: none;
        border-radius: 12px;
        cursor: pointer;
        overflow: hidden;
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(201, 247, 111, 0.2);
    }
    
    .btn-biz-pay:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(201, 247, 111, 0.4);
    }
    
    .btn-biz-pay:active {
        transform: translateY(1px);
    }
    
    .btn-biz-pay:disabled {
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.4);
        cursor: not-allowed;
        box-shadow: none;
    }

    .pay-btn-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pay-btn-glow {
        position: absolute;
        top: 0; left: -100%;
        width: 50%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
        transform: skewX(-20deg);
        animation: payGlow 3s infinite;
        z-index: 1;
    }
    
    @@keyframes payGlow {
        0% { left: -100%; }
        20% { left: 200%; }
        100% { left: 200%; }
    }
</style>

@section Scripts {
<script src="https://js.stripe.com/v3/"></script>
<script>
$(function () {
    const clientSecret = '@ViewBag.ClientSecret';
    const pk = '@ViewBag.StripePublishableKey';
    let stripe, elements;

    if (pk && !pk.includes("placeholder")) {
        stripe = Stripe(pk);
        elements = stripe.elements({ clientSecret, appearance: { theme: 'stripe' } });
        const paymentElement = elements.create('payment');
        paymentElement.mount('#stripe-payment-element');
    } else {
        $('#stripe-payment-element').hide();
        $('#card-mockup').show();
    }
    $('#cardExpiryInput').on('input', function() {
        let v = $(this).val().replace(/\D/g, '');
        if(v.length > 2) v = v.substring(0,2) + '/' + v.substring(2,4);
        $(this).val(v);
    });

    $('#cardNumberInput').on('input', function() {
        let v = $(this).val().replace(/\s+/g, '').replace(/[^0-9]/gi, '');
        let formatted = v.match(/\d{1,4}/g);
        $(this).val(formatted ? formatted.join(' ') : '');
        
        let icon = $('#cardBrandIcon');
        if (v.startsWith('4')) icon.attr('class', 'fa-brands fa-cc-visa');
        else if (v.startsWith('5')) icon.attr('class', 'fa-brands fa-cc-mastercard');
        else if (v.startsWith('3')) icon.attr('class', 'fa-brands fa-cc-amex');
        else if (v.startsWith('6')) icon.attr('class', 'fa-brands fa-cc-discover');
        else icon.attr('class', 'fa-regular fa-credit-card');
    });

    $('.payment-method-card').on('click', function () {
        const method = $(this).data('method');
        $('.payment-method-card').removeClass('active');
        $(this).addClass('active');

        // Switch Tabs
        $('.payment-tab-content').hide();
        if (method === 'Card') $('#card-tab').show();
        else if (method === 'UPI') $('#upi-tab').show();
        else if (method === 'Net Banking') $('#nb-tab').show();
    });

    $('#pay-btn').on('click', async function () {
        const btn = $(this);
        const method = $('.payment-method-card.active').data('method');
        
        btn.prop('disabled', true).html('<i class="fa-solid fa-spinner-third fa-spin"></i> Authorizing Payment...');

        if (method === 'Card' && stripe) {
            const { error, paymentIntent } = await stripe.confirmPayment({
                elements,
                redirect: 'if_required' 
            });

            if (error) {
                BizSuite.showToast(error.message, 'error');
                resetBtn(btn);
                return;
            }
            
            // On success, notify backend
            submitToBackend(btn, method, paymentIntent.id);
        } else {
            // Mock submission
            submitToBackend(btn, method, "mock_intent");
        }
    });

    function submitToBackend(btn, method, intentId) {
        BizSuite.post('/Payment/Process', { orderId: @Model.Header.OrderId, method: method, paymentIntentId: intentId }, function (res) {
            if (res.success) {
                BizSuite.showToast('Payment successful! Label generated.', 'success');
                setTimeout(() => {
                    location.href = '/Payment/Success?txn=' + res.transactionId;
                }, 800);
            } else {
                BizSuite.showToast(res.message || 'Payment failed. Please try again.', 'error');
                resetBtn(btn);
            }
        });
    }

    function resetBtn(btn) {
        btn.prop('disabled', false).html('<span class="pay-btn-content"><i class="fa-solid fa-lock"></i> Pay Now (₹@Model.Header.Total.ToString("N0"))</span><div class="pay-btn-glow"></div>');
    }
});
</script>
}
