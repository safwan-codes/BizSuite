@model BizSuite.Models.Dashboard.StaffDashboardViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Staff Dashboard";
    bool notClockedIn  = !Model.IsClockedIn;
    bool clockedIn     = Model.IsClockedIn && !Model.IsClockedOut;
    bool clockedOut    = Model.IsClockedOut;
}

@* Hidden form to provide antiforgery token for AJAX calls *@
<form id="__AjaxAntiForgery" style="display:none;">@Html.AntiForgeryToken()</form>

<!-- Schedule Modal -->
<div id="scheduleModal" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:480px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fa-solid fa-calendar-days"></i> My Work Schedule</div>
            <button class="modal-close" onclick="$('#scheduleModal').fadeOut()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            <p>Your typical shift timings are: <strong>@Model.ShiftStart - 6:00 PM</strong></p>
            <p>Make sure to clock in when you start your shift and clock out when you leave.</p>
        </div>
    </div>
</div>

<div class="shift-banner">
    <div class="shift-info">
        <div class="shift-dot"></div>
        <div>
            <div class="shift-text">Shift Active — @Model.ShiftStart</div>
            <div class="shift-time">@DateTime.Now.ToString("dddd, dd MMMM yyyy · hh:mm tt")</div>
        </div>
    </div>
    <div class="d-flex align-center gap-12">
        @if (notClockedIn)
        {
            <span class="badge-biz info"><i class="fa-solid fa-circle-pause"></i> Not Clocked In</span>
            <button class="btn-biz-secondary" id="btnClockIn" style="font-size:13px; background:var(--accent-lime); color:var(--text-dark); border-color:var(--accent-lime);">
                <i class="fa-solid fa-clock"></i> Clock In
            </button>
        }
        else if (clockedIn)
        {
            <span class="badge-biz success"><span class="badge-dot"></span>On Duty (Since @Model.ClockInTime?.ToString("hh:mm tt"))</span>
            <button class="btn-biz-secondary" id="btnClockOut" style="font-size:13px;">
                <i class="fa-solid fa-clock"></i> Clock Out
            </button>
        }
        else
        {
            <span class="badge-biz warning"><i class="fa-solid fa-circle-check"></i> Shift Ended</span>
            <button class="btn-biz-secondary" disabled style="font-size:13px; opacity:0.6;">
                <i class="fa-solid fa-clock"></i> Clocked Out
            </button>
        }
    </div>
</div>

<div class="d-flex align-center justify-between mb-24">
    <div>
        <h1 style="font-size:24px; font-weight:800; letter-spacing:-0.5px;">
            Ready to crush it, <span style="color:var(--accent-lime);">@Model.UserFullName.Split(' ')[0]</span>! 💪
        </h1>
        <p style="color:var(--text-secondary); font-size:14px; margin-top:4px;">
            You have
            <strong style="color:var(--warning);">@Model.OrdersToday new orders</strong> and
            <strong style="color:var(--info);">@Model.PendingTickets support tickets</strong> waiting.
        </p>
    </div>
    <div class="d-flex gap-12">
        @if (Context.Session.GetString("RoleName") == "Manager")
        {
            <a href="/Staff/StaffList" class="btn-biz-outline" style="border-radius:12px; padding:8px 16px;">
                <i class="fa-solid fa-users-gear"></i> Manage Team
            </a>
        }
        <a href="/Staff/OrderEntry" class="quick-action-btn">
            <i class="fa-solid fa-circle-plus"></i> New Order
        </a>
        <button class="quick-action-btn secondary" onclick="$('#scheduleModal').fadeIn();">
            <i class="fa-solid fa-calendar"></i> View Schedule
        </button>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 360px; gap:20px; margin-bottom:24px;">

    <div style="display:flex; flex-direction:column; gap:20px;">

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div class="kpi-card lime">
                <div class="kpi-card-header">
                    <span class="kpi-card-label">Orders Today</span>
                    <div class="kpi-icon lime"><i class="fa-solid fa-cart-shopping"></i></div>
                </div>
                <div class="kpi-value">@Model.OrdersToday</div>
                <div class="kpi-change up">
                    <i class="fa-solid fa-arrow-trend-up"></i> +2
                    <span>since morning</span>
                </div>
            </div>
            <div class="kpi-card info">
                <div class="kpi-card-header">
                    <span class="kpi-card-label">Pending Tickets</span>
                    <div class="kpi-icon info"><i class="fa-solid fa-headset"></i></div>
                </div>
                <div class="kpi-value">@Model.PendingTickets</div>
                <div class="kpi-change down">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>need attention</span>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">
                    <i class="fa-solid fa-list-check panel-icon"></i> Action Desk
                </div>
                <span style="font-size:12px; color:var(--text-muted);">@Model.ActionItems.Count tasks</span>
            </div>
            <div class="panel-body" style="padding:0 24px 8px;">
                
                <div style="display:grid; grid-template-columns:90px 1fr 90px 90px 110px; gap:12px; padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.06);">
                    <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-muted);">Order</span>
                    <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-muted);">Customer</span>
                    <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-muted);">Priority</span>
                    <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-muted);">Time</span>
                    <span style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-muted);">Action</span>
                </div>
                @foreach (var item in Model.ActionItems)
                {
                    var prioClass = item.Priority switch { "High"=>"danger","Medium"=>"warning",_=>"success" };
                    var prioDot   = item.Priority switch { "High"=>"fa-triangle-exclamation","Medium"=>"fa-circle-dot",_=>"fa-circle-check" };
                    <div style="display:grid; grid-template-columns:90px 1fr 90px 90px 110px; gap:12px; align-items:center; padding:13px 0; border-bottom:1px solid rgba(255,255,255,0.04);">
                        <span style="font-family:monospace; font-size:13px; font-weight:700; color:var(--accent-lime);">@item.OrderId</span>
                        <span style="font-size:13px; color:var(--text-primary); font-weight:600;">@item.Customer</span>
                        <span class="badge-biz @prioClass">
                            <i class="fa-solid @prioDot" style="font-size:9px;"></i> @item.Priority
                        </span>
                        <span style="font-size:12px; color:var(--text-muted);">@item.Time</span>
                        <button class="btn-action">
                            <i class="fa-solid fa-play"></i> Process
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="panel" style="height:fit-content;">
        <div class="panel-header">
            <div class="panel-title">
                <i class="fa-solid fa-triangle-exclamation panel-icon" style="color:var(--warning);"></i>
                Low Stock Alerts
            </div>
            <a href="/Staff/InventoryCheck" style="font-size:12px; color:var(--accent-mint);">View all</a>
        </div>
        <div class="panel-body">
            @foreach (var alert in Model.LowStockAlerts)
            {
                <div class="low-stock-item">
                    <div class="low-stock-product">
                        <div class="low-stock-icon @(alert.IsCritical ? "" : "")">
                            <i class="fa-solid fa-box@(alert.IsCritical ? "" : "-open")"></i>
                        </div>
                        <div>
                            <div class="low-stock-name">@alert.ProductName</div>
                            <div class="low-stock-sku">@alert.SKU</div>
                        </div>
                    </div>
                    <div class="low-stock-qty @(alert.IsCritical ? "" : "warn")">
                        <i class="fa-solid fa-triangle-exclamation" style="font-size:11px;"></i>
                        @alert.Remaining left
                    </div>
                </div>
            }

            <div style="margin-top:16px; padding-top:16px; border-top:1px solid rgba(255,255,255,0.06);">
                <div style="background:rgba(251,191,36,0.08); border:1px solid rgba(251,191,36,0.2); border-radius:10px; padding:12px 14px; font-size:12px; color:var(--warning); display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-circle-info"></i>
                    Contact the admin to reorder. @Model.LowStockAlerts.Count items need attention.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(function() {
    
    $('#btnClockIn').on('click', function() {
        const token = $('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').val();
        $.post('/Staff/ClockIn', { __RequestVerificationToken: token }, function(res) {
            if (res.success) location.reload();
            else BizSuite.showToast(res.message, 'error');
        });
    });

    $('#btnClockOut').on('click', function() {
        const token = $('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').val();
        $.post('/Staff/ClockOut', { __RequestVerificationToken: token }, function(res) {
            if (res.success) location.reload();
            else BizSuite.showToast(res.message, 'error');
        });
    });

    $(document).on('click', '.btn-action:contains("Process")', function () {
        const $btn = $(this);
        const $row = $btn.closest('div[style*="grid"]');
        $btn.html('<i class="fa-solid fa-spinner fa-spin"></i>').prop('disabled', true);
        setTimeout(() => {
            $row.css({ opacity: 0, transition: 'opacity 0.3s ease' });
            setTimeout(() => $row.remove(), 350);
            BizSuite.showToast('Order processed successfully!', 'success');
        }, 900);
    });
});
</script>
}
