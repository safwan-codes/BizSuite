@using BizSuite.Models.Staff
@model StaffViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Add Staff Member";
}

<div class="page-header">
    <div class="breadcrumb-biz">
        <i class="fa-solid fa-house"></i>
        <span class="sep">/</span>
        <a href="/Staff/StaffList" style="color:var(--text-muted);">Staff</a>
        <span class="sep">/</span>
        <span>Add Member</span>
    </div>
    <div>
        <h1><span>Add</span> Staff Member</h1>
        <p>Fill in the details to onboard a new team member</p>
    </div>
</div>

<div style="max-width:680px; margin:0 auto;">
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">
                <i class="fa-solid fa-user-plus panel-icon"></i> New Staff Details
            </div>
        </div>
        <div style="padding:28px;">
            <form asp-action="CreateStaff" asp-controller="Staff" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert-biz danger mb-16" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
                    
                    <div style="grid-column:1/-1;">
                        <label asp-for="FullName" class="form-label-biz">Full Name *</label>
                        <div style="position:relative;">
                            <i class="fa-solid fa-user" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:13px;"></i>
                            <input asp-for="FullName" id="FullName" class="form-input-biz" style="padding-left:38px;" placeholder="e.g. Riya Sharma" autocomplete="off" />
                        </div>
                        <span asp-validation-for="FullName" class="validation-err"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="form-label-biz">Email Address *</label>
                        <div style="position:relative;">
                            <i class="fa-solid fa-envelope" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:13px;"></i>
                            <input asp-for="Email" id="Email" class="form-input-biz" style="padding-left:38px;" placeholder="staff@company.com" />
                        </div>
                        <span asp-validation-for="Email" class="validation-err"></span>
                    </div>

                    <div>
                        <label asp-for="Phone" class="form-label-biz">Phone Number *</label>
                        <div style="position:relative;">
                            <i class="fa-solid fa-phone" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:13px;"></i>
                            <input asp-for="Phone" id="Phone" class="form-input-biz" style="padding-left:38px;" placeholder="9876500000" />
                        </div>
                        <span asp-validation-for="Phone" class="validation-err"></span>
                    </div>

                    <div>
                        <label asp-for="Role" class="form-label-biz">Role *</label>
                        <select asp-for="Role" id="Role" class="form-input-biz">
                            <option value="Staff">Staff</option>
                            @if (User.IsInRole("Admin"))
                            {
                                <option value="Manager">Manager</option>
                                <option value="Supervisor">Supervisor</option>
                                <option value="Admin">Admin (Careful!)</option>
                            }
                        </select>
                        <span asp-validation-for="Role" class="validation-err"></span>
                    </div>

                    <div>
                        <label asp-for="Department" class="form-label-biz">Department *</label>
                        <select asp-for="Department" id="Department" class="form-input-biz">
                            <option value="">-- Select --</option>
                            <option value="Sales">Sales</option>
                            <option value="Inventory">Inventory</option>
                            <option value="Support">Support</option>
                            <option value="Operations">Operations</option>
                            <option value="Finance">Finance</option>
                            <option value="HR">HR</option>
                        </select>
                        <span asp-validation-for="Department" class="validation-err"></span>
                    </div>

                    <div style="display:flex; align-items:center; gap:12px; grid-column:1/-1; padding:12px 0;">
                        <input asp-for="IsActive" id="IsActive" type="checkbox" style="width:18px;height:18px;accent-color:var(--accent-lime);cursor:pointer;" />
                        <label asp-for="IsActive" style="color:var(--text-secondary);font-size:14px;cursor:pointer;">Mark as Active</label>
                    </div>
                </div>

                <div class="d-flex gap-12" style="margin-top:24px;">
                    <button type="submit" class="quick-action-btn" id="submitBtn">
                        <i class="fa-solid fa-user-plus"></i> Add Staff Member
                    </button>
                    <a href="/Staff/StaffList" class="btn-biz-outline" style="padding:10px 20px;">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
$('#submitBtn').on('click', function () {
    $(this).html('<i class="fa-solid fa-spinner fa-spin"></i> Saving...');
});
</script>
}
