@model BizSuite.Models.Auth.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Code | BizSuite</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <style>
        :root {
            --theme-bg: #0f3d2f;      
            --theme-dark: #071912;
            --accent-lime: #cbfb45;   
            --form-bg: #f4f7f6; 
            --input-bg: #e6efe9; 
            --text-dark: #0f3d2f;
            --text-muted: #64748b;
        }

        body, html {
            height: 100%; margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: var(--theme-dark);
        }

        .speckle-pattern {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 0;
            background-image: radial-gradient(var(--accent-lime) 1px, transparent 1px);
            background-size: 60px 60px;
            opacity: 0.15; 
        }

        .login-wrapper {
            position: relative; z-index: 10; min-height: 100vh;
            display: flex; align-items: center; justify-content: center; padding: 1rem;
        }

        .card-custom {
            width: 100%; max-width: 450px; background-color: var(--form-bg); border-radius: 30px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); padding: 3rem;
            animation: fadeIn 0.5s ease;
        }

        @@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .form-title { color: var(--text-dark); font-weight: 700; font-size: 1.8rem; text-align: center; margin-bottom: 0.5rem; }
        .form-subtitle { color: var(--text-muted); text-align: center; font-size: 0.95rem; margin-bottom: 2rem; }
        
        .form-control {
            background-color: var(--input-bg); border: 2px solid transparent; border-radius: 50px; 
            padding: 0.9rem; color: var(--text-dark); font-weight: 700; text-align: center; font-size: 1.5rem; letter-spacing: 0.5rem; transition: all 0.3s;
        }
        .form-control:focus {
            background-color: #ffffff; border-color: var(--accent-lime); box-shadow: 0 0 0 4px rgba(203, 251, 69, 0.2);
            outline: none;
        }

        .btn-primary {
            background-color: var(--accent-lime); color: var(--text-dark); border: none; border-radius: 50px; 
            padding: 0.9rem; font-weight: 700; font-size: 1.05rem; width: 100%; margin-top: 1.5rem;
            box-shadow: 0 4px 15px rgba(203, 251, 69, 0.4);
        }
        .btn-primary:hover { background-color: #d8fc6c; transform: translateY(-2px); }

        .back-link { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 1.5rem; color: var(--text-muted); text-decoration: none; font-weight: 500; }
    </style>
</head>
<body>
    <div class="speckle-pattern"></div>
    <div class="login-wrapper">
        <div class="card-custom">
            <div class="text-center mb-4">
                <i class="ph ph-shield-check" style="font-size: 3.5rem; color: var(--theme-bg);"></i>
            </div>
            <h2 class="form-title">Verify Code</h2>
            <p class="form-subtitle">Enter the 6-digit verification code sent to <b>@Model.Email</b></p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 mb-3 rounded-pill text-center" style="font-size: 0.85rem;">@ViewBag.Error</div>
            }

            <form asp-controller="Auth" asp-action="VerifyCode" method="post">
                <input type="hidden" name="email" value="@Model.Email" />
                
                <div class="mb-2">
                    <input type="text" name="code" class="form-control" placeholder="000000" maxlength="6" required autocomplete="off" autofocus>
                </div>

                <button type="submit" class="btn btn-primary">VERIFY CODE</button>
                
                <a href="/Auth/ForgotPassword" class="back-link">
                    <i class="ph ph-arrow-left"></i> Request new code
                </a>
            </form>
        </div>
    </div>
</body>
</html>