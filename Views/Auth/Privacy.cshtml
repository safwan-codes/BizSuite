@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Privacy Policy - BizSuite</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; padding: 40px; color: #333; max-width: 800px; margin: 0 auto; }
        h1 { color: #0F3D33; border-bottom: 2px solid #C9F76F; padding-bottom: 10px; }
        h2 { color: #124D3B; margin-top: 30px; }
    </style>
</head>
<body>
    <h1>Privacy Policy</h1>
    <p>Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
    
    <h2>1. Data Collection</h2>
    <p>We collect essential business data, employee details, and transaction logs strictly to power your ERP workspace. We do not sell your data to third parties.</p>

    <h2>2. Security</h2>
    <p>We implement industry-standard encryption to protect your data at rest and during transit. All checkout flows utilize PCI-compliant gateways.</p>

    <h2>3. Cookies</h2>
    <p>We use functional cookies to maintain your login session and preferences across the dashboard.</p>
</body>
</html>
