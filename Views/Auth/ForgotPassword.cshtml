@model BizSuite.Models.Auth.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | BizSuite</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --theme-bg: #0f3d2f;      
            --theme-dark: #071912;
            --accent-lime: #cbfb45;   
            --accent-mint: #7ee3c4;
            --form-bg: #f4f7f6; 
            --input-bg: #e6efe9; 
            --text-dark: #0f3d2f;
            --text-muted: #64748b;
        }

        body, html {
            height: 100%; margin: 0;
            font-family: 'Outfit', sans-serif;
            background-color: var(--theme-dark);
            overflow: hidden;
        }

        .speckle-pattern {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 0;
            background-image: radial-gradient(var(--accent-lime) 1px, transparent 1px), radial-gradient(var(--accent-lime) 1.5px, transparent 1.5px);
            background-size: 60px 60px, 90px 90px;
            background-position: 0 0, 30px 30px;
            opacity: 0.15; 
        }

        .login-wrapper {
            position: relative; z-index: 10; min-height: 100vh;
            display: flex; align-items: center; justify-content: center; padding: 1rem;
        }

        .card-custom {
            width: 100%; max-width: 450px; background-color: var(--form-bg); border-radius: 30px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); overflow: hidden; padding: 3rem;
            animation: fadeIn 0.5s ease;
        }

        @@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        .form-title { color: var(--text-dark); font-weight: 700; font-size: 1.8rem; text-align: center; margin-bottom: 0.5rem; }
        .form-subtitle { color: var(--text-muted); text-align: center; font-size: 0.95rem; margin-bottom: 2rem; }
        
        .form-control {
            background-color: var(--input-bg); border: 1px solid transparent; border-radius: 50px; 
            padding: 0.85rem 1.5rem 0.85rem 3.2rem; color: var(--text-dark); font-weight: 500; transition: all 0.3s;
        }
        .form-control:focus {
            background-color: #ffffff; border-color: var(--accent-lime); box-shadow: 0 0 0 4px rgba(203, 251, 69, 0.2);
        }
        .input-group-custom { position: relative; margin-bottom: 1.5rem; }
        .input-icon { position: absolute; left: 20px; top: 50%; transform: translateY(-50%); color: var(--text-dark); font-size: 1.2rem; z-index: 5; opacity: 0.6; }

        .btn-primary {
            background-color: var(--accent-lime); color: var(--text-dark); border: none; border-radius: 50px; 
            padding: 0.9rem; font-weight: 700; font-size: 1.05rem; width: 100%; margin-top: 1rem;
            box-shadow: 0 4px 15px rgba(203, 251, 69, 0.4); transition: all 0.2s;
        }
        .btn-primary:hover { background-color: #d8fc6c; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(203, 251, 69, 0.5); color: var(--theme-dark); }

        .back-link { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 1.5rem; color: var(--text-muted); text-decoration: none; font-weight: 500; font-size: 0.9rem; }
        .back-link:hover { color: var(--theme-bg); text-decoration: underline; }
    </style>
</head>
<body>
    <div class="speckle-pattern"></div>
    <div class="login-wrapper">
        <div class="card-custom">
            <div class="text-center mb-4">
                <i class="ph ph-keyhole" style="font-size: 3rem; color: var(--theme-bg);"></i>
            </div>
            <h2 class="form-title">Forgot Password</h2>
            <p class="form-subtitle">Enter your email and we'll send you a verification code to reset your password.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 mb-3 rounded-pill text-center" style="font-size: 0.85rem;">@ViewBag.Error</div>
            }

            <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                <div class="input-group-custom">
                    <i class="ph ph-envelope-simple input-icon"></i>
                    <input type="email" name="email" class="form-control" placeholder="Work Email" required>
                </div>

                <button type="submit" class="btn btn-primary">SEND CODE</button>
                
                <a href="/Auth/Login" class="back-link">
                    <i class="ph ph-arrow-left"></i> Back to login
                </a>
            </form>
        </div>
    </div>
</body>
</html>